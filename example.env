#for tracing graph execution
#ref: https://docs.langchain.com/oss/python/langgraph/studio
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langchain-api-key
LANGSMITH_PROJECT=your-langsmith-project
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

GOOGLE_API_KEY=your-google-api-key


POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=anti_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# LangGraph agent-server expects a sync Postgres URI for managed persistence.
# Docker compose overrides this to use host `db` and port `5432` inside the
# compose network.
POSTGRES_URI=postgresql://user:pass@localhost:5433/anti_db

# Public/local MCP URL. Docker compose overrides agent-server to use
# http://mcp:8001/mcp inside the compose network.
MCP_SERVER_URL=http://localhost:8001/mcp

# Public/local FastAPI -> internal LangGraph agent-server URL. Docker compose
# overrides backend to use http://agent-server:2024 inside the compose network.
AGENT_SERVER_URL=http://localhost:2024

DISCOVERY_AGENT_MODEL=google_genai:gemini-3.1-flash-lite-preview
LEARNING_DIRECTOR_MODEL=google_genai:gemini-3.1-flash-lite-preview
CODE_VALIDATOR_MODEL=google_genai:gemini-3.1-flash-lite-preview
CONTENT_GENERATOR_MODEL=gemini-3.1-flash-lite-preview
MEMORY_ADVISOR_MODEL=google_genai:gemini-3.1-flash-lite-preview
MEMORY_EMBEDDING_MODEL=gemini-embedding-2

# Module-level LangGraph exports are only built when running the LangGraph
# agent-server. Keep 0 for ordinary FastAPI imports and deterministic tests.
ANTI_PILOT_BUILD_MODULE_GRAPHS=0

# Keep these disabled for normal local/non-live tests. Set to 1 only when you
# want the memory services to invoke real LLM advisors instead of deterministic
# fallback behavior.
ENABLE_MEMORY_HINT_ADVISOR=0
ENABLE_MEMORY_RERANK_ADVISOR=0
ENABLE_MEMORY_INTEGRITY_ADVISOR=0

# Set to 1 when running gated live memory advisor smoke tests.
RUN_LIVE_AGENT_MEMORY_TESTS=0

# Set to 1 when running gated live Discovery e2e smoke tests:
#   tests/test_live_discovery_e2e_workflow.py
#   tests/test_live_discovery_multi_goal_e2e.py
RUN_LIVE_DISCOVERY_E2E_TESTS=0
DISCOVERY_E2E_BASE_URL=http://localhost:8000
DISCOVERY_E2E_TIMEOUT_SECONDS=300
# Keep generated live Discovery rows for manual DB inspection. Use 0 for normal
# cleanup after the test.
DISCOVERY_E2E_KEEP_DATA=0

# Set to 1 when running backend/tests/test_learning_director_smoke.py with
# the real content-generation graph and real ADK content generator.
# Keep 0 for deterministic smoke runs that use the fake content graph.
LEARNING_DIRECTOR_SMOKE_REAL_CONTENT=0

# Optional Supabase integration placeholders. Leave empty for local backend
# tests unless a caller explicitly uses app.lib.supabase.
SUPABASE_URL=
SUPABASE_KEY=
