#for tracing graph execution
#ref: https://docs.langchain.com/oss/python/langgraph/studio
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langchain-api-key
LANGSMITH_PROJECT=your-langsmith-project
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

GOOGLE_API_KEY=your-google-api-key

POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=anti_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

MCP_SERVER_URL=http://localhost:8001/mcp
CODE_VALIDATOR_MODEL=google_genai:gemini-3.1-pro-preview

# Set to 1 when running backend/tests/test_learning_director_smoke.py with
# the real content-generation graph and real ADK content generator.
# Keep 0 for deterministic smoke runs that use the fake content graph.
LEARNING_DIRECTOR_SMOKE_REAL_CONTENT=0
